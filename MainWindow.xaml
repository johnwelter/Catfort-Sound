<Window x:Class="CatfortSound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatfortSound"
        xmlns:views="clr-namespace:CatfortSound.ViewModels"
        xmlns:tables="clr-namespace:CatfortSound.SoundEngine.DataTables"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Catfort Sound
        " Height="832" Width="909"
        SizeToContent="Width"
        >
    <Window.Resources>
        <Thickness x:Key="tbMargin">0, 0, 0, 0</Thickness>
        <Thickness x:Key="buttonMargin">0, 10, 0, 0</Thickness>

        <ContextMenu x:Key="OscContext">
            
        </ContextMenu>

        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="tables:Lengths"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
    </Window.Resources>
    <Grid >
        <Menu x:Name="UI_Menu"  DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" Click="Toolbar_New"/>
                <MenuItem Header="Open..." Click="Toolbar_Open"/>
                <MenuItem Header="Save" Click="Toolbar_Save"/>
                <MenuItem Header="Save As..." Click="Toolbar_SaveAs"/>
                <MenuItem Header="Export..." Click="Toolbar_Export"/>
                <MenuItem Header="Open Effects..." Click="Toolbar_OpenEffects"/>
                <MenuItem Header="Save Effects..." Click="Toolbar_OpenEffects"/>
                <MenuItem Header="Export Effects..." Click="Toolbar_ExportEffects"/>
                <Separator/>
                <!--MenuItem Header="Settings..." Click="Toolbar_Settings"/-->
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="Toolbar_About"/>
            </MenuItem>
        </Menu>
        <!-- Main Window -->
        <StackPanel x:Name="UI_MainWindow"  Orientation="Horizontal" Margin="0,21,0,0">
            <!-- Playback and Volume Controls -->
            <StackPanel Orientation="Vertical">
                <StackPanel x:Name="UI_VolumeControls" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Slider}">
                            <Setter Property="Margin" Value="{StaticResource tbMargin}"/>
                        </Style>
                    </StackPanel.Resources>
                    <DockPanel>
                        <StackPanel Orientation="Vertical">
                            <Label Content="Square 1"/>
                            <Slider x:Name="sq1_vol" HorizontalAlignment="Center" Width="30" Orientation="Vertical" Maximum="1" TickPlacement="BottomRight" TickFrequency="0.1" Height="160"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel Orientation="Vertical">
                            <Label Content="Square 2"/>
                            <Slider x:Name="sq2_vol" HorizontalAlignment="Center" Width="30" Orientation="Vertical" Maximum="1" TickPlacement="BottomRight" TickFrequency="0.1" Height="160"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel Orientation="Vertical">
                            <Label Content="Triangle"/>
                            <Slider x:Name="tri_vol" HorizontalAlignment="Center" Width="30" Orientation="Vertical" Maximum="1" TickPlacement="BottomRight" TickFrequency="0.1" Height="160"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel Orientation="Vertical">
                            <Label Content="Noise"/>
                            <Slider x:Name="noi_vol" HorizontalAlignment="Center" Width="30" Orientation="Vertical" Maximum="1" TickPlacement="BottomRight" TickFrequency="0.1" Height="160"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel>
                            <Label Content="DMC"/>
                            <Slider x:Name="dmc_vol" HorizontalAlignment="Center" Width="30" Orientation="Vertical" Maximum="1" TickPlacement="BottomRight" TickFrequency="0.1" Height="160"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                <StackPanel x:Name="UI_PlaybackControls" Orientation="Vertical" Width="200">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="{StaticResource buttonMargin}"/>
                        </Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Margin" Value="{StaticResource buttonMargin}"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="play_button" Content="play" Click="play_button_Click" IsEnabled="false">

                    </Button>
                    <Button x:Name="stop_button" Content="stop" Click="stop_button_Click" IsEnabled="False"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="tempo" Text="{Binding Tempo}" PreviewTextInput="Tempo_Validate" Width="42" VerticalAlignment="Center"/>
                        <Label x:Name="framesPerLabel" Content="Tick add per frame (tempo)"/>
                    </StackPanel>
                    <Label x:Name="UI_currentIdxLabel" Content="{Binding SelectedIndex, FallbackValue=--}"/>
                </StackPanel>
            </StackPanel>
            <!-- Tracker Lists -->
            <DockPanel x:Name="UI_TrackerDock">
                <TabControl x:Name="tabControl" SelectionChanged="Tab_changed">
                    <TabItem Header="Square1">
                        <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                            <StackPanel x:Name="UI_Sq1_DelaySection" Orientation="Horizontal">
                                <Label x:Name="UI_Sq1_delayLabel" Content="ChannelDelay"/>
                                <ComboBox x:Name="UI_Sq1_delayDropDown"  ItemsSource="{Binding Source={StaticResource dataFromEnum}}" SelectedItem="{Binding DelayLength}"/>
                            </StackPanel>
                            <ScrollViewer Height="500">
                                <StackPanel>
                                    <DataGrid x:Name="p1Grid" CanUserSortColumns="False" PreviewKeyDown="Copy" ItemsSource="{Binding Entries}" SelectionChanged="Track_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Transpose..." Click="Transpose"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Height="100">
                                <StackPanel>
                                    <DataGrid x:Name="p1Subloops" CanUserSortColumns="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Square2">
                        <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                            <StackPanel x:Name="UI_Sq2_DelaySection" Orientation="Horizontal">
                                <Label x:Name="UI_Sq2_delayLabel" Content="ChannelDelay"/>
                                <ComboBox x:Name="UI_Sq2_delayDropDown" ItemsSource="{Binding Source={StaticResource dataFromEnum}}" SelectedItem="{Binding DelayLength}"/>
                            </StackPanel>
                            <ScrollViewer Height="500">
                                <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                                    <DataGrid x:Name="p2Grid" CanUserSortColumns="False" PreviewKeyDown="Copy" ItemsSource="{Binding Entries}" SelectionChanged="Track_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Transpose..." Click="Transpose"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Height="100">
                                <StackPanel>
                                    <DataGrid x:Name="p2Subloops" CanUserSortColumns="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Triangle">
                        <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                            <StackPanel x:Name="UI_Tri_DelaySection" Orientation="Horizontal">
                                <Label x:Name="UI_Tri_delayLabel" Content="ChannelDelay"/>
                                <ComboBox x:Name="UI_Tri_delayDropDown" ItemsSource="{Binding Source={StaticResource dataFromEnum}}" SelectedItem="{Binding DelayLength}"/>
                            </StackPanel>
                            <ScrollViewer Height="500">
                                <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                                    <DataGrid x:Name="tGrid"  CanUserSortColumns="False" PreviewKeyDown="Copy" ItemsSource="{Binding Entries}" SelectionChanged="Track_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Transpose..." Click="Transpose"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Height="100">
                                <StackPanel>
                                    <DataGrid x:Name="tSubloops" CanUserSortColumns="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Noise">
                        <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                            <StackPanel x:Name="UI_Noi_DelaySection" Orientation="Horizontal">
                                <Label x:Name="UI_Noi_delayLabel" Content="ChannelDelay"/>
                                <ComboBox x:Name="UI_Noi_delayDropDown" ItemsSource="{Binding Source={StaticResource dataFromEnum}}" SelectedItem="{Binding DelayLength}"/>
                            </StackPanel>
                            <ScrollViewer Height="500">
                                <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                                    <DataGrid x:Name="nGrid"  CanUserSortColumns="False" PreviewKeyDown="Copy" ItemsSource="{Binding Entries}" SelectionChanged="Track_SelectionChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Height="500">
                                <StackPanel>
                                    <DataGrid x:Name="nSubloops" CanUserSortColumns="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="DMC">
                        <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                            <StackPanel x:Name="UI_DMC_DelaySection" Orientation="Horizontal">
                                <Label x:Name="UI_DMC_delayLabel" Content="ChannelDelay"/>
                                <ComboBox x:Name="UI_DMC_delayDropDown" ItemsSource="{Binding Source={StaticResource dataFromEnum}}" SelectedItem="{Binding DelayLength}"/>
                            </StackPanel>
                            <ScrollViewer Height="500">
                                <StackPanel Orientation="Vertical" Background="#FFE5E5E5">
                                    <DataGrid x:Name="dmcGrid"  CanUserSortColumns="False" PreviewKeyDown="Copy" ItemsSource="{Binding Entries}" SelectionChanged="Track_SelectionChanged"/>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Height="100">
                                <StackPanel>
                                    <DataGrid x:Name="dmcSubloops" CanUserSortColumns="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
            <!-- Effect Editor -->
            <StackPanel x:Name="UI_EffectEditorStack" Width="415">
                <views:EffectEditor x:Name="UI_EffectEditor" Height="272" Loaded="UI_EffectEditor_Loaded"/>
                <DockPanel>
                    <TabControl x:Name="EffectTabs">
                        <TabItem Header="Vol">
                            <ListView x:Name="VolEffectList" Height="347" Margin="0,10,0,0" SelectionChanged="EffectList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn DisplayMemberBinding="{Binding Path=Name}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                        <TabItem Header="Mod">
                            <ListView x:Name="ModEffectList" Height="347" Margin="0,10,0,0" SelectionChanged="EffectList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn DisplayMemberBinding="{Binding Path=Name}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                        <TabItem Header="Arp">
                            <ListView x:Name="ArpEffectList" Height="347" Margin="0,10,0,0" SelectionChanged="EffectList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn DisplayMemberBinding="{Binding Path=Name}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                        <TabItem Header="Duty">
                            <ListView x:Name="DutyEffectList" Height="347" Margin="0,10,0,0" SelectionChanged="EffectList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn DisplayMemberBinding="{Binding Path=Name}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="AddEffect" Content="Add" Click="AddEffect_Click" Height="29" Width="160" Margin="0,15,20,0"/>
                    <Button x:Name="RemoveEffect" Content="Remove" Click="RemoveEffect_Click" Height="29" Width="160" Margin="20,15,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>


    </Grid>
</Window>
