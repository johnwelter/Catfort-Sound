<UserControl x:Name="userControl" x:Class="CatfortSound.ViewModels.EffectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatfortSound.ViewModels"
             xmlns:convert="clr-namespace:ValueConverters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <convert:EffectImageScaleConverter x:Key="ScaleConverter"></convert:EffectImageScaleConverter>
        <convert:EffectImageScaleConverterInv x:Key="InvScaleConverter"></convert:EffectImageScaleConverterInv>
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <Border x:Name="EffectBorder" ClipToBounds="True"  MouseLeftButtonDown="Click" MouseLeftButtonUp="Release" MouseMove="Hold" MouseRightButtonDown="RightClick"  MouseLeave="Leave" Height="200">
                <Grid x:Name="EffectViewer">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Path=EffectObject.Length, ElementName=userControl, Converter={StaticResource ScaleConverter}}"/>
                    </Grid.RenderTransform>
                    <Image x:Name="EffectImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill"></Image>
                    <Line x:Name="LoopLine" Stroke="Green" StrokeThickness="{Binding Path=EffectObject.Length, ElementName=userControl, Converter={StaticResource InvScaleConverter}}"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="effectName" Text="{Binding Path=EffectObject.Name, ElementName=userControl, UpdateSourceTrigger=PropertyChanged}" Width="292" Margin="10,0,10,0"/>
                <TextBox x:Name="effectLength" Text="{Binding Path=EffectObject.Length, ElementName=userControl, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="EffectLength_Validate" Width="42"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
